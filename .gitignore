# virtual environments
.venv/
env/
venv/

# Jupyter
.ipynb_checkpoints/

# data: downloaded by the notebook, not committed
*.csv
**/data/*
!**/data/.gitkeep

# model files: on Hugging Face, not on GitHub
*.onnx
*.pt
*.joblib

# Cloudflare and Node
node_modules/
.wrangler/

# OS files
.DS_Store
Thumbs.db

# secrets: NEVER commit these
.env
.dev.vars
kaggle.json

# example tiles from RIAWELC: the dataset must not be re-uploaded
**/model_app/examples/

# model server: the ONNX model must be in the repo so Render can build it
!02_model_server/anomaly_ae.onnx
# model server example tiles come from RIAWELC: not redistributed
02_model_server/examples/*
!02_model_server/examples/.gitkeep

# Python cache
__pycache__/

# Neural Network Lab: caches and figures with RIAWELC pixels
neural_lab/.cache/
neural_lab/outputs/
.pytest_cache/
.gradio/
flagged/

# model server: NEURAL / LAB bundle (built by 02_model_server/build_lab.py: model halves + 115 tiles at 64 px)
!02_model_server/lab/models/*.onnx
!02_model_server/lab/data/
!02_model_server/lab/data/*

# NEURAL / LAB proof room: the untrained twin (random weights, no data) is served with the page
!neural_lab/playground/static/control.onnx
!02_model_server/lab/static/control.onnx
